# =============================================================================
# Deutsch A1 — Variables d'environnement
# Copiez ce fichier en `.env` et renseignez vos clés Supabase Cloud & Gemini.
# Ne commitez JAMAIS le fichier `.env` dans Git.
# =============================================================================

# --- Frontend (Vite) & Script de seed ---
# URL HTTPS de votre projet Supabase Cloud (ex: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique "anon" (Publishable / anon key) trouvée dans Project Settings > API
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clé API Google Gemini côté client pour le bouton "Why is this wrong?" (explication d'erreur IA)
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- Scripts serveur uniquement (NE PAS exposer avec le préfixe VITE_) ---
# URL Supabase pour les scripts Node (si non définie, le script lit VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clé secrète "service_role" (trouvée dans Project Settings > API) pour l'upsert en base
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clé API Google Gemini (Google AI Studio) pour l'enrichissement pédagogique A1
GEMINI_API_KEY=your-gemini-api-key
